{
  "name": "Thali — Daily Food Tracker",
  "short_name": "Thali",
  "description": "Indian-first food tracker: log breakfast, lunch, snacks and dinner with quantity and time.",
  "id": "/",
  "start_url": "/#/today",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#070812",
  "theme_color": "#070812",
  "categories": ["health", "food", "lifestyle"],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Today", "url": "/#/today", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Insights", "url": "/#/insights", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
